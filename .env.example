ENV=development

# Local SQLite / produção PostgreSQL
DATABASE_URL=sqlite:///data/monitor.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/monitor

API_TRIGGER_TOKEN=change-me
SCHEDULE_CRON=0 7 * * 1-5
SCHEDULE_HOUR=7
TZ=America/Sao_Paulo
JOB_MAX_ATTEMPTS=3

# Painel web (login humano — separado do API_TRIGGER_TOKEN)
UI_SESSION_SECRET=change-me-ui-session-secret
UI_ADMIN_USER=admin
UI_ADMIN_PASSWORD=troque-esta-senha
UI_SESSION_HOURS=72

# DJEN / Comunica API
DJEN_ENABLE=true
DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1/comunicacao
DJEN_MAX_CONCURRENCY=2
DJEN_OVERLAP_HOURS=48
# Bootstrap / HISTORICAL_DISCOVERY (dias). 1095 ≈ 3 anos
DJEN_HISTORICAL_LOOKBACK_DAYS=1095
# Egress BR (Railway→PC via Tailscale). No PC:
#   python -m monitor_jus.sources.djen.egress_proxy
# Depois: DJEN_HTTP_PROXY=http://100.x.y.z:8899  (IP Tailscale do PC)
DJEN_HTTP_PROXY=

# DataJud (chave pública do CNJ — enriquecimento, não novidade)
DATAJUD_ENABLE=true
DATAJUD_MODE=selective
DATAJUD_API_KEY=
DATAJUD_API_KEY_URL=https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_MAX_CONCURRENCY=3
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# CNA (fora do caminho crítico; desligado na v1)
CNA_ENABLED=false
CNA_API_TOKEN=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_FALLBACK_MODELS=anthropic/claude-sonnet-4.6,openai/gpt-5.2-mini
OPENROUTER_MAX_CONCURRENCY=2
OPENROUTER_TIMEOUT_SECONDS=40
OPENROUTER_MAX_RETRIES=2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

RESEND_API_KEY=
RESEND_MAX_CONCURRENCY=1
EMAIL_FROM=
EMAIL_TO=

MONITORAMENTOS_PATH=config/monitoramentos.yaml
CONFIG_DIR=config
OUTBOX_DIR=data/outbox
