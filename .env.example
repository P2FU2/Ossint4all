ENV=development

# Local SQLite / produção PostgreSQL
DATABASE_URL=sqlite:///data/monitor.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/monitor

API_TRIGGER_TOKEN=change-me
SCHEDULE_CRON=0 7 * * 1-5
SCHEDULE_HOUR=7
TZ=America/Sao_Paulo
JOB_MAX_ATTEMPTS=3

# Judit — flags default false (habilitar só o contratado)
JUDIT_API_KEY=
JUDIT_REQUESTS_BASE_URL=https://requests.production.judit.io
JUDIT_TRACKING_BASE_URL=https://tracking.production.judit.io
JUDIT_ENABLE_HISTORICAL_SEARCH=false
JUDIT_ENABLE_OAB=false
JUDIT_ENABLE_CPF_CNPJ=false
JUDIT_ENABLE_NAME=false
JUDIT_ENABLE_PROCESS_TRACKING=false
JUDIT_ENABLE_DOCUMENT_TRACKING=false
JUDIT_ENABLE_DJEN=false
JUDIT_ENABLE_ATTACHMENTS=false
JUDIT_MAX_CONCURRENCY=3

JUDIT_WEBHOOK_AUTH_MODE=static_token
JUDIT_WEBHOOK_TOKEN=
JUDIT_WEBHOOK_SIGNATURE_HEADER=
JUDIT_WEBHOOK_SIGNATURE_ALGORITHM=sha256
JUDIT_WEBHOOK_ALLOWED_IPS=

# DataJud (chave pública do CNJ — não é credencial individual)
DATAJUD_ENABLE=true
DATAJUD_MODE=selective
DATAJUD_API_KEY=
DATAJUD_API_KEY_URL=https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_MAX_CONCURRENCY=3
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_FALLBACK_MODELS=anthropic/claude-sonnet-4.6,openai/gpt-5.2-mini
OPENROUTER_MAX_CONCURRENCY=2
OPENROUTER_TIMEOUT_SECONDS=40
OPENROUTER_MAX_RETRIES=2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

RESEND_API_KEY=
RESEND_MAX_CONCURRENCY=1
EMAIL_FROM=
EMAIL_TO=

MONITORAMENTOS_PATH=config/monitoramentos.yaml
CONFIG_DIR=config
OUTBOX_DIR=data/outbox
