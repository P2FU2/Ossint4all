ENV=development
DATABASE_URL=sqlite:///data/osint4all.db

UI_SESSION_SECRET=change-me-ui-session-secret
UI_ADMIN_USER=admin
UI_ADMIN_PASSWORD=admin
UI_SESSION_HOURS=72

# Expansão síncrona no pedido (útil sem worker separado)
EXPAND_SYNC=true
EXPAND_SYNC_LIMIT=25
DEFAULT_MAX_DEPTH=2

# CNPJ — Minha Receita (padrão) ou BrasilAPI
CNPJ_PROVIDER=minhareceita
CNPJ_ENABLE=true

# DataJud (chave pública do CNJ)
DATAJUD_ENABLE=true
DATAJUD_API_KEY=
DATAJUD_API_KEY_URL=https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# DJEN / Comunica API (egress Brasil)
DJEN_ENABLE=true
DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1/comunicacao
DJEN_HTTP_PROXY=

# TSE, Transparência, OpenCorporates, Wikidata, busca web, usernames
TSE_ENABLE=true
TRANSPARENCIA_ENABLE=true
TRANSPARENCIA_API_KEY=
OPENCORPORATES_ENABLE=true
OPENCORPORATES_API_TOKEN=
WIKIDATA_ENABLE=true
WEB_SEARCH_ENABLE=true
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
USERNAME_PUBLIC_ENABLE=true
CRTSH_ENABLE=true
PLATE_PUBLIC_ENABLE=true
SOCIO_SEARCH_ENABLE=true
BRASIL_IO_API_TOKEN=

# IA opcional para o dossiê
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Monitoramento
SCHEDULE_CRON=0 7 * * 1-5
TZ=America/Sao_Paulo
